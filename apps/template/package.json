{
  "name": "@ld/app-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "architecture:check": "bash ../../tooling/architecture-check/architecture-check.sh .",
    "generate:types": "tsx ./scripts/generate-directus-types.ts"
  },
  "dependencies": {
    "@directus/sdk": "catalog:",
    "@ld/directus": "workspace:*",
    "@ld/forms": "workspace:*",
    "@ld/react-utils": "workspace:*",
    "@ld/ui": "workspace:*",
    "@ld/utils": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "valibot": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@ld/config-eslint": "workspace:*",
    "@ld/config-playwright": "workspace:*",
    "@ld/config-typescript": "workspace:*",
    "@ld/config-vite": "workspace:*",
    "@ld/config-vitest": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "catalog:",
    "directus-sdk-typegen": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
